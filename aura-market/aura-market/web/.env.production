# Production Environment Configuration
# Used when deployed to Vercel or other production hosting

# Frontend runs on: https://yourdomain.com
# Backend runs on: https://api.yourdomain.com or http://your-backend-domain:5000

# Backend URL for the Next.js API Bridge
# This is used by the /api/v1/[...path] route to forward requests to your backend
# Update with your actual production backend domain/IP
NEXT_PUBLIC_BACKEND_URL=http://13.51.198.119:5000

# Frontend URL (for CORS headers in API bridge)
# Update with your actual production frontend domain
NEXT_PUBLIC_FRONTEND_URL=https://aura-market-com.vercel.app

# Note: NEXT_PUBLIC_API_URL is not needed for production because:
# - On production (Vercel), the api.js file uses the /api/v1 bridge route
# - The bridge route will use NEXT_PUBLIC_BACKEND_URL to proxy requests
