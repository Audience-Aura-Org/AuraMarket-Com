# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/auradime
MONGODB_MAX_POOL_SIZE=25
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_IDLE_MS=60000

# Redis / Scaling (optional locally, recommended in production)
REDIS_URL=
REDIS_TLS=false
REDIS_CACHE_ENABLED=true
REDIS_RATE_LIMIT_ENABLED=true
REDIS_SOCKET_ENABLED=true
API_CACHE_TTL_SECONDS=60
API_CACHE_REDIS_PREFIX=auradime:api-cache:
API_RATE_LIMIT_MAX=1200
API_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=1000
PUBLIC_RATE_LIMIT_WINDOW_MS=900000
STRICT_RATE_LIMIT_MAX=120
STRICT_RATE_LIMIT_WINDOW_MS=900000
SOCKET_TRANSPORTS=websocket,polling
WEB_CONCURRENCY=2
PM2_MAX_MEMORY=650M
JOB_QUEUE_CONCURRENCY=4
JOB_QUEUE_ATTEMPTS=3
JOB_QUEUE_BACKOFF_MS=1500

# JWT — keep access tokens short-lived; use refresh tokens for long sessions
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=24h

# Email / SMTP (required for order confirmations and OTP)
EMAIL_HOST=smtp.titan.email
EMAIL_PORT=587
EMAIL_USER=hello@yourdomain.com
EMAIL_PASS=your_email_password
EMAIL_SECURE=false
EMAIL_FROM_NAME=Auradime
# Sender address. With Titan it must be the EMAIL_USER mailbox or one of its aliases
# (e.g. add noreply@ as an alias of support@ in Titan admin, then set it here).
EMAIL_FROM=noreply@yourdomain.com
# Where replies go (a monitored inbox). Defaults to EMAIL_USER.
EMAIL_REPLY_TO=support@yourdomain.com
# Alternative: Resend API (leave blank if using SMTP above)
RESEND_API_KEY=

# Web Push / PWA Notifications — REQUIRED, no fallbacks
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Android Push Notifications / Firebase Cloud Messaging
# Use ONE of these on the backend. google-services.json is only for the Android app;
# the backend needs a Firebase service account to send closed-app Android pushes.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# AWS S3 (File Storage - Persistent for Vercel/AWS deployments)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_bucket_name
AWS_S3_ENABLED=false

# Flutterwave (Payments)
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key

# Eversend (Mobile Money — XAF, UGX, KES, etc.)
EVERSEND_CLIENT_ID=your_eversend_client_id
EVERSEND_CLIENT_SECRET=your_eversend_client_secret
# Get this from the Eversend dashboard → Webhook settings
EVERSEND_WEBHOOK_SECRET=your_eversend_webhook_secret
EVERSEND_BASE_URL=https://api.eversend.co/v1

# PayUnit (Cameroon Mobile Money — MTN/Orange)
PAYUNIT_API_USERNAME=your_payunit_api_username
PAYUNIT_API_PASSWORD=your_payunit_api_password
PAYUNIT_LIVE_KEY=your_payunit_live_key
PAYUNIT_SANDBOX_KEY=your_payunit_sandbox_key
PAYUNIT_MODE=live
PAYUNIT_BASE_URL=https://gateway.payunit.net
# Get this from the PayUnit dashboard → Webhook configuration
PAYUNIT_WEBHOOK_SECRET=your_payunit_webhook_secret

# PawaPay Mobile Money (Cameroon — MTN MoMo / Orange Money)
# Get API token from: https://dashboard.pawapay.io → Developers → API Tokens
# Callback URLs to enter in PawaPay dashboard:
#   Deposits: https://api.yourdomain.com/api/v1/payments/pawapay/webhook/deposit
#   Refunds:  https://api.yourdomain.com/api/v1/payments/pawapay/webhook/refund
PAWAPAY_API_TOKEN=your_pawapay_api_token
PAWAPAY_SANDBOX_MODE=false
# Optional: PawaPay RSA public key in PEM format for full RFC-9421 webhook signature verification.
# Leave blank to use Content-Digest (body hash) verification only.
PAWAPAY_WEBHOOK_PUBLIC_KEY=
# Set to true in production to additionally verify that webhook requests originate
# from PawaPay's known egress IPs: 18.192.208.15, 18.195.113.136, 3.72.212.107, 3.65.153.31
PAWAPAY_ENFORCE_IP_ALLOWLIST=false

# Set to true only after PawaPay activates Orange Money Cameroon on the account.
PAWAPAY_ORANGE_ENABLED=false

# Mobile money fees passed on to the payer, in percent (see utils/mobileMoneyFees.js).
# The customer pays gross = (net x (1 + payout%) + fixed) / (1 - collection%), so the
# wallet gets the full net amount and withdrawing it later costs the platform nothing.
# Defaults are the published Cameroon rates; replace with your contract rates.
MOMO_FEE_PAWAPAY_MTN_PCT=1.75
MOMO_FEE_PAWAPAY_ORANGE_PCT=1.77
MOMO_FEE_EVERSEND_PCT=1.42
# PayUnit does not publish rates; set this from your PayUnit contract.
MOMO_FEE_PAYUNIT_PCT=1.77
# Withdrawals are paid out through PawaPay MTN.
MOMO_PAYOUT_FEE_PCT=1.3
MOMO_FEE_FIXED_XAF=0

# Client URLs
WEB_CLIENT_URL=http://localhost:3000
MOBILE_CLIENT_URL=exp://localhost:19000

# Debug / Development — NEVER set to true in production (server will refuse to start)
ENABLE_DEBUG_ROUTES=false
DISABLE_ESCROW_AUTO_RELEASE=false

# WhatsApp Business Platform (Meta Cloud API) — see docs/whatsapp-setup.md
# Any random string; paste the same value into Meta's webhook "Verify token" box.
WHATSAPP_VERIFY_TOKEN=
# Permanent System User token (Business Settings → System users → Generate token,
# permissions: whatsapp_business_messaging, whatsapp_business_management).
WHATSAPP_TOKEN=
# WhatsApp Manager → API setup → "Phone number ID" (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Manager URL "asset_id=…" or API setup → "WhatsApp Business Account ID".
# Used by scripts/whatsapp-templates.js to submit/check message templates.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App settings → Basic → App secret (verifies webhook signatures).
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# Android app updates (GET /app/version; scripts/notify-app-update.js)
# Newest APK on the download page. Apps below it show an "Update available" bar.
APP_LATEST_VERSION=1.7.1
# Optional: apps below this version get a blocking "Update required" screen.
APP_MIN_VERSION=
APP_DOWNLOAD_URL=https://auradime.com/downloads/Auradime.apk

# OpenRouteService: road routes and arrival times on tracking pages (free key at openrouteservice.org)
ORS_API_KEY=
