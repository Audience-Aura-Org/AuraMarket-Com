# Development Environment Configuration
# Copy this file to .env.local and update with your local IP address

# Find your laptop IP:
# Windows: Open Command Prompt and run: ipconfig
#   Look for "IPv4 Address" under your active connection (e.g., 192.168.x.x)
# macOS/Linux: Open Terminal and run: ifconfig
#   Look for "inet " address (e.g., 192.168.x.x)

# Example: If your laptop IP is 192.168.1.100:
# NEXT_PUBLIC_API_URL=http://192.168.1.100:5000/api/v1

# After updating, other devices can access:
# Frontend: http://192.168.1.100:3000
# Backend: http://192.168.1.100:5000

NEXT_PUBLIC_API_URL=http://YOUR_LAPTOP_IP:5000/api/v1
