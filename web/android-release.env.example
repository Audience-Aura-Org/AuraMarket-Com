# Android release signing.
# Never commit the real keystore or real passwords.
AURA_RELEASE_STORE_FILE=C:\\path\\to\\auradime-release.keystore
AURA_RELEASE_STORE_PASSWORD=change-me
AURA_RELEASE_KEY_ALIAS=auradime
AURA_RELEASE_KEY_PASSWORD=change-me

# Mobile production API endpoints must stay HTTPS-only.
NEXT_PUBLIC_API_URL=https://api.auradime.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.auradime.com
NEXT_PUBLIC_BACKEND_URL=https://api.auradime.com
