{
  "name": "aura-market-web",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "dev:network": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "mobile:build:web": "node scripts/build-capacitor.mjs",
    "mobile:sync:android": "npm run mobile:build:web && npx cap sync android",
    "mobile:open:android": "npx cap open android",
    "mobile:build:android:debug": "npm run mobile:sync:android && cd android && gradlew.bat assembleDebug",
    "mobile:build:android:release": "npm run mobile:sync:android && cd android && gradlew.bat assembleRelease",
    "mobile:build:android:bundle": "npm run mobile:sync:android && cd android && gradlew.bat bundleRelease",
    "mobile:add:ios": "npm install @capacitor/ios && npx cap add ios",
    "mobile:sync:ios": "npm run mobile:build:web && npx cap sync ios",
    "mobile:open:ios": "npx cap open ios"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@tailwindcss/postcss": "^4.2.2",
    "autoprefixer": "^10.4.27",
    "axios": "^1.13.6",
    "framer-motion": "^12.36.0",
    "hls.js": "^1.6.16",
    "lightningcss": "^1.32.0",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "playwright": "^1.58.2",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2",
    "@tailwindcss/oxide-linux-x64-musl": "4.2.2",
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "lightningcss-linux-x64-musl": "^1.32.0"
  }
